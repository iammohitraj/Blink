<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Blink\Assets\blink.ico</ApplicationIcon>
    <AssemblyName>BlinkSetup</AssemblyName>
    <RootNamespace>Blink.Setup</RootNamespace>
    <Product>Blink Setup</Product>
    <AssemblyTitle>Blink Setup</AssemblyTitle>
    <Description>Installs and updates Blink.</Description>
  </PropertyGroup>

  <!-- The installer shares Blink's theme and brand sources so the two windows stay
       pixel-identical without shipping a separate copy of the UI. -->
  <ItemGroup>
    <Compile Include="..\Blink\Ui\Theme.cs" Link="Ui\Theme.cs" />
    <Compile Include="..\Blink\Ui\Shapes.cs" Link="Ui\Shapes.cs" />
    <Compile Include="..\Blink\Ui\CardPanel.cs" Link="Ui\CardPanel.cs" />
    <Compile Include="..\Blink\Ui\AccentButton.cs" Link="Ui\AccentButton.cs" />
    <Compile Include="..\Blink\Ui\AppIcon.cs" Link="Ui\AppIcon.cs" />
    <Compile Include="..\Blink\Ui\LogoView.cs" Link="Ui\LogoView.cs" />
    <Compile Include="..\Blink\Ui\WindowButton.cs" Link="Ui\WindowButton.cs" />
    <Compile Include="..\Blink\Ui\WindowEffects.cs" Link="Ui\WindowEffects.cs" />
    <Compile Include="..\Blink\Ui\SwitchToggle.cs" Link="Ui\SwitchToggle.cs" />
    <Compile Include="..\Blink\Ui\StatusDot.cs" Link="Ui\StatusDot.cs" />
    <Compile Include="..\Blink\NativeMethods.cs" Link="NativeMethods.cs" />
    <Compile Include="..\Blink\AppInfo.cs" Link="AppInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blink.Core\Blink.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Blink\Assets\blink.ico" LogicalName="Blink.Assets.blink.ico" />
    <EmbeddedResource Include="..\..\dist\Blink.exe" LogicalName="Blink.Setup.payload.exe" Condition="Exists('..\..\dist\Blink.exe')" />
  </ItemGroup>

</Project>
