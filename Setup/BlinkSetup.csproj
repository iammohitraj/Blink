<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Assets\blink.ico</ApplicationIcon>
    <AssemblyName>BlinkSetup</AssemblyName>
    <RootNamespace>Blink.Setup</RootNamespace>
    <Product>Blink Setup</Product>
    <AssemblyTitle>Blink Setup</AssemblyTitle>
    <Description>Installs and updates Blink.</Description>
  </PropertyGroup>

  <!-- Blink's shared sources are compiled straight into this assembly, so the installer
       reuses the exact same theme, controls and brand metadata as the app itself. -->
  <ItemGroup>
    <Compile Include="..\Ui\Theme.cs" Link="Ui\Theme.cs" />
    <Compile Include="..\Ui\Shapes.cs" Link="Ui\Shapes.cs" />
    <Compile Include="..\Ui\CardPanel.cs" Link="Ui\CardPanel.cs" />
    <Compile Include="..\Ui\AccentButton.cs" Link="Ui\AccentButton.cs" />
    <Compile Include="..\Ui\AppIcon.cs" Link="Ui\AppIcon.cs" />
    <Compile Include="..\Ui\LogoView.cs" Link="Ui\LogoView.cs" />
    <Compile Include="..\Ui\WindowButton.cs" Link="Ui\WindowButton.cs" />
    <Compile Include="..\Ui\WindowEffects.cs" Link="Ui\WindowEffects.cs" />
    <Compile Include="..\Ui\SwitchToggle.cs" Link="Ui\SwitchToggle.cs" />
    <Compile Include="..\Ui\StatusDot.cs" Link="Ui\StatusDot.cs" />
    <Compile Include="..\NativeMethods.cs" Link="NativeMethods.cs" />
    <Compile Include="..\AppInfo.cs" Link="AppInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Assets\blink.ico" LogicalName="Blink.Assets.blink.ico" />
    <EmbeddedResource Include="..\dist\Blink.exe" LogicalName="Blink.Setup.payload.exe" Condition="Exists('..\dist\Blink.exe')" />
  </ItemGroup>

</Project>
