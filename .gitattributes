# Normalise text files, keep build outputs and images untouched.
* text=auto

*.cs          text eol=lf
*.csproj      text eol=lf
*.props       text eol=lf
*.targets     text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.md          text eol=lf
*.sln         text eol=crlf
*.ps1         text eol=crlf

*.ico         binary
*.png         binary
*.exe         binary
*.dll         binary
